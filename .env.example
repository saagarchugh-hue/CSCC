# Copy this file to `.env` or `Keys.env` in the same folder as app.py and fill in your keys.
# `.env` and `Keys.env` are gitignored — never commit them.
#
#   cp .env.example .env
#   # edit .env with your real keys

# Required for Generate email, OpenAI news/strategic brief
OPENAI_API_KEY=

# Recommended for Latest news (Gemini + Google Search grounding)
GEMINI_API_KEY=

# Optional news fallbacks
# NEWS_API_KEY=
# SERPER_API_KEY=

# Optional model overrides (defaults are fine for most users)
# OPENAI_EMAIL_MODEL=gpt-4o-mini
# OPENAI_NEWS_MODEL=gpt-4o
# GEMINI_NEWS_MODEL=gemini-2.0-flash

# Optional: live dashboard data from a published Google Sheet
# GOOGLE_SHEET_ID=
# GOOGLE_SHEET_GID=0
